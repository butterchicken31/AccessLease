
# Copy this file to .env.local and configure your environment.
# NEVER commit .env.local or real API keys.

# The AI assistant is optional. Without a key, other features should still work.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Demo date is fixed so results remain consistent.
# Set to "live" to use the real clock.
# DEMO_DATE=live
