# Copy to .env.local and fill in. NEVER commit .env.local.
# The AI assistant is optional: without a key the search box still works.
GROQ_API_KEY=your_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Demo date is fixed to 2026-10-15 so results never change. Use "live" for the real clock.
# DEMO_DATE=live
